            // and the CB_BMASK bulk load on the bucket path.
            if (env_on("GSPLAT_TT_BUCKET_MASK")) {
                reader_defines["MB_BUCKET_MASK"] = "1";
            }
            if (env_on("GSPLAT_TT_BUCKET_MASK_DEBUG")) {
