worry_threshold_s = 600
timeout_s = 1200

[gate]
metric_name = "hero_vs_ref"
metric_threshold = 63.6                       # CONFIRM: the live gate in bh30_run_verify.sh
metric_lower = 0
require_timings = 1                            # verify now emits TTW_TIMING proj/ta/sort/blend
require_screenshot = 0                         # set 1 + a glob once tt-workflows owns shots
require_report = 1
require_commit = 1
screenshot_glob = "opt/ttw/shots/*.png"

[workspace]
tmp_dir = "tmp"                               # repo-local gitignored scratch (no junk in root or ~/dev)
require_clean_workspace = 1

[report]
report_cmd = ""                               # built-in generator (metric trend + table)
report_html = "opt/ttw/REPORT.html"           # isolated from the live opt/REPORT.html

[log]
iters_jsonl = "opt/ttw/iters.jsonl"           # isolated from the live loop's records

[loop]
stuck_after = 3
min_improvement = 0.02
stop_file = "STOP"
worker_model = "claude-4.6-sonnet-medium-thinking"
apply_cmd = ""                                # supervisor-driven (agent applies each change)
build_kind = "cpp"
# North star: ~1 ms/frame wall time (supervisor still gates on hero_vs_ref >= 63.6).
goal_value = "1.0"
goal_metric = "ms_view
