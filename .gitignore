# Transient scratch (ttw hygiene: all transient output -> gitignored tmp/)
tmp/

# Test artifacts
.pytest_cache/

# REPORT assets are TRACKED (committed, via git-LFS for the binaries) so the
# report's links stay valid forever — see .gitattributes (*.png/*.tracy/*.ply in
# LFS). Only genuine JUNK is ignored here (regenerable derivatives + logs +
# scratch), which belongs in the gitignored tmp/. DO NOT re-add a blanket opt/
# ignore (it lived in .git/info/exclude and broke the report links).
opt/screenshots/*/timing.jsonl
opt/screenshots/*/run.log
opt/screenshots/*/build.log
opt/screenshots/*/test.log
opt/screenshots/*/.validator_prompt.md
opt/viewer-*.pid
opt/viewer-*.log

# CPython byproducts of our pyd extensions (iter-001+)
*.so
*.dylib

# Heavy scene PLYs (>10MB). luigi.ply is in git from the master baseline;
# stitch_doll.ply ships from outside the repo (live on disk at /Users/smarton/dev/gsplat_tt/scenes/)
# and is copied into scenes/ by Phase 0 setup.
scenes/stitch_doll.ply
scenes/strawberry.ply
scenes/bicycle.ply
scenes/point_cloud.ply

# Per-stage fixtures (regenerable derivatives of the PLY + numpy reference path).
# `scripts/capture_reference.py --scene stitch` rewrites them; we keep only the
# meta.json so the dir tree is visible in git.
# Hero fixtures are tracked (iter-007+). Do not ignore tests/fixtures/hero/*.npz.

# Metal port runtime artifacts (regenerable on bh-30)
generated/
opt/metal-supervisor.log
opt/amendment002-*.log
opt/amendment002-supervisor.pid
opt/amendment002-supervisor-state.json.tmp
opt/amendment002-workers/
opt/backfill-*.log
opt/logs/
opt/cull_tune.jsonl
opt/cull_tune_summary.json
# PNGs are TRACKED via git-LFS (.gitattributes) — they are the report's hero/
# diff/ref images and must stay valid. Only the regenerable .npy arrays + OS
# cruft are junk. Stale pre-ttw experiment dirs (metal-iter-*/amendment-*) are
# left ignored (not linked by the live report); move them to tmp/ if tidying.
opt/metal-screenshots/**/*.npy
opt/metal-screenshots/**/.DS_Store
opt/metal-screenshots/metal-iter-*/
opt/metal-screenshots/amendment-*/

# setup_bh30_metal.sh symlinks tt-metal from gsplat_tt on the remote box
backends/tt/tt-metal

# IDE / OS
.DS_Store
.idea/
.vscode/

# tt-loop local control sentinel (never committed)
STOP
/tmp/

# ──────────────────────────────────────────────────────────────────────────
# opt/ POLICY (authoritative, last-match-wins): the report + its linked assets
# are TRACKED so the report stays valid forever (binaries via git-LFS, see
# .gitattributes). Everything else under opt/ is junk/scratch and stays ignored
# (belongs in the gitignored tmp/). Ignore all of opt/, then re-include exactly
# the report deliverables. NOTE: re-including a file inside an ignored dir
# requires un-ignoring each parent dir first, hence the dir-then-file layering.
opt/*
!opt/REPORT.html
!opt/build_report.py
!opt/*.md
# ledger + report mirror
!opt/ttw/
opt/ttw/*
!opt/ttw/iters.jsonl
!opt/ttw/REPORT.html
# per-iter Tracy traces the report links (ttw-* only; LFS)
!opt/profiler/
opt/profiler/*
!opt/profiler/ttw-*/
opt/profiler/ttw-*/*
!opt/profiler/ttw-*/render.tracy
# per-iter hero/diff/ref renders the report links (ttw-* only; LFS)
!opt/metal-screenshots/
opt/metal-screenshots/*
!opt/metal-screenshots/ttw-*/
opt/metal-screenshots/ttw-*/*
!opt/metal-screenshots/ttw-*/*.png
