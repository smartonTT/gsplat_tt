*.egg-info/

# CMake / build artifacts
build/
.last-build-commit
*.o
*.obj
compile_commands.json

# Test artifacts
.pytest_cache/

# Per-iter renders (large PNG blobs).
# We track the iters.jsonl + decision JSON to record history, but the PNG
# bodies live in opt/screenshots/ and are not committed to keep the repo size
# manageable. The validator subagent reads them from disk only.
opt/screenshots/*/hero.png
opt/screenshots/*/side.png
opt/screenshots/*/top.png
opt/screenshots/*/back.png
opt/screenshots/*/adj_*.png
opt/screenshots/*/orbit_*.png
opt/screenshots/*/elev_*.png
opt/screenshots/*/chal_*.png
opt/screenshots/*/*_diff10.png
opt/screenshots/*/timing.jsonl
opt/screenshots/*/run.log
opt/screenshots/*/build.log
opt/screenshots/*/test.log
opt/screenshots/*/.validator_prompt.md
opt/REPORT.html

# CPython byproducts of our pyd extensions (iter-001+)
*.so
*.dylib

# Heavy scene PLYs (>10MB). luigi.ply is in git from the master baseline;
# stitch_doll.ply ships from outside the repo (live on disk at /Users/smarton/dev/gsplat_tt/scenes/)
# and is copied into scenes/ by Phase 0 setup.
scenes/stitch_doll.ply
scenes/strawberry.ply
scenes/point_cloud.ply

# IDE / OS
.DS_Store
.idea/
.vscode/
