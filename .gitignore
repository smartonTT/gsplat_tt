# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
*.egg-info/

# CMake / build artifacts
build/
.last-build-commit
*.o
*.obj
compile_commands.json

# Test artifacts
.pytest_cache/

# Per-iter renders (large PNG blobs). Everything inside opt/screenshots/<iter>/ is
# regeneratable from iters.jsonl + the source code, and we keep the canonical
# references in benchmarks/reference_v2/ instead. Track only the iter folders'
# JSON metadata + log so we have an audit trail.
opt/screenshots/*/*.png
opt/screenshots/*/timing.jsonl
opt/screenshots/*/run.log
opt/screenshots/*/build.log
opt/screenshots/*/test.log
opt/screenshots/*/.validator_prompt.md
opt/REPORT.html

# CPython byproducts of our pyd extensions (iter-001+)
*.so
*.dylib

# Heavy scene PLYs (>10MB). luigi.ply is in git from the master baseline;
# stitch_doll.ply ships from outside the repo (live on disk at /Users/smarton/dev/gsplat_tt/scenes/)
# and is copied into scenes/ by Phase 0 setup.
scenes/stitch_doll.ply
scenes/strawberry.ply
scenes/point_cloud.ply

# Per-stage fixtures (regenerable derivatives of the PLY + numpy reference path).
# `scripts/capture_reference.py --scene stitch` rewrites them; we keep only the
# meta.json so the dir tree is visible in git.
# Hero fixtures are tracked (iter-007+). Do not ignore tests/fixtures/hero/*.npz.

# Metal port runtime artifacts (regenerable on bh-30)
generated/
opt/metal-supervisor.log
opt/metal-screenshots/**/*.png
opt/metal-screenshots/**/*.npy
opt/metal-screenshots/**/.DS_Store
opt/metal-screenshots/metal-iter-*/

# setup_bh30_metal.sh symlinks tt-metal from gsplat_tt on the remote box
backends/tt/tt-metal

# IDE / OS
.DS_Store
.idea/
.vscode/
