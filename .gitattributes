tests/fixtures/hero/*.npz filter=lfs diff=lfs merge=lfs -text

# Report assets must stay valid forever -> tracked, but they are large binaries,
# so they go through git-LFS (not packed into the git history). Covers the hero/
# diff/ref renders and the per-iter Tracy traces the report links.
opt/**/*.png filter=lfs diff=lfs merge=lfs -text
opt/**/*.tracy filter=lfs diff=lfs merge=lfs -text
# Heavy scene point clouds (luigi.ply is grandfathered in plain git from the
# baseline; new/large PLYs land in LFS).
*.ply filter=lfs diff=lfs merge=lfs -text
